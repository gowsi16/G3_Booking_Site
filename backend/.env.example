# =====================================================================
# G3 Transport - Backend Environment Configuration Template
# Copy this file to backend/.env and update with your real credentials.
# =====================================================================

PORT=5000

# Strong secret for signing admin JWT authentication tokens
JWT_SECRET=g3_transport_super_secure_jwt_secret_key_2026_production

# Admin Master Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=gthreetransport@gmail.com

# Gmail SMTP Configuration for Nodemailer (Google App Password)
# Note: Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=gthreetransport@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_google_app_password
